{
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(//home/clay/**)",
      "Edit(//home/clay/**)",
      "Grep(//home/clay/**)",
      "LS(//home/clay/**)",
      "WebSearch",
      "WebFetch(domain:*)",
      "TodoWrite(*)",
      "BashOutput(*)",
      "KillBash(*)",
      "ExitPlanMode(*)"
    ],
    "deny": [
      "Bash(gh:*)"
    ],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/clay"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/.claude/statusline.sh",
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "qt-development-skills@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "/var/run/docker.sock",
        "~/.ssh/ssh_auth_sock"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git",
      "docker"
    ]
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "companyAnnouncements": [
    "https://github.com/claydugo/dotfiles"
  ],
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: Ramona Optics",
      "**Cloud provider(s)**: None configured",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default; protection status not queryable)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: GitLab",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "### User-specific",
      "**Primary use of Claude Code**: software development — computational imaging at Ramona Optics",
      "**Org-specific CLIs**: pixi (env management — never use pip to install/upgrade/uninstall), glab (GitLab CLI), mcam (project CLI)",
      "State-changing git/jj operations (add, commit, push, branch ops) require explicit in-conversation confirmation; read-only git is routine"
    ]
  }
}
