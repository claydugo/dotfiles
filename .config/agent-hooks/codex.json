{
  "description": "Enforce personal rules with wristslap.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/wristslap\" hook codex",
            "timeout": 10,
            "statusMessage": "Loading personal rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/wristslap\" hook codex",
            "timeout": 10,
            "statusMessage": "Checking personal rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/wristslap\" hook codex",
            "timeout": 10,
            "statusMessage": "Checking changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/wristslap\" hook codex",
            "timeout": 10,
            "statusMessage": "Checking completion"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/wristslap\" hook codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
